PORT=5002
DATABASE_URL=mongodb://127.0.0.1:27017/bloodlink
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
SETUP_SECRET=replace-with-a-separate-random-bootstrap-secret
# Optional: without this value, images are stored locally in bloodlink_backend/uploads.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Gmail account and app password used for transactional emails.
MAIL_ID=notifications@example.com
MP=replace-with-gmail-app-password
MAIL_FROM="BloodLink <notifications@example.com>"
APP_URL=http://localhost:5174
